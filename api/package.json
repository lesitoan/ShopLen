{
  "name": "tiemLenApi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/resolvePathAlias.mjs",
    "start": "node dist/server.js",
    "typeCheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
