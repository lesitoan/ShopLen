{
  "name": "tiem-len-nest-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typeCheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 tests/unit/*.test.ts",
    "prisma:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "eslint src tests *.mjs prisma.config.ts --max-warnings=0"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.0.7",
    "cloudinary": "2.10.0",
    "date-fns": "4.4.0",
    "dotenv": "16.6.1",
    "express-rate-limit": "8.6.1",
    "google-auth-library": "10.9.1",
    "helmet": "7.2.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "redis": "6.1.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.18.0",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "telegraf": "4.16.3",
    "uuid": "14.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "20.19.43",
    "eslint": "10.13.0",
    "prisma": "7.9.0",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "deepmerge-ts": "8.0.0",
    "find-my-way": "9.7.0",
    "mysql2": "3.24.0",
    "valibot": "1.4.2"
  }
}
